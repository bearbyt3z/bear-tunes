{
  "name": "bear-tunes",
  "version": "0.38.5",
  "description": "flac/mp3 converter & tagging tool based on Beatport tag style",
  "main": "./dist/main.js",
  "type": "module",
  "imports": {
    "#config": {
      "types": "./src/config.ts",
      "default": "./dist/config.js"
    },
    "#tools": {
      "types": "./src/tools/index.ts",
      "default": "./dist/tools/index.js"
    },
    "#processor": {
      "types": "./src/processor/index.ts",
      "default": "./dist/processor/index.js"
    },
    "#converter": {
      "types": "./src/converter/index.ts",
      "default": "./dist/converter/index.js"
    },
    "#renamer": {
      "types": "./src/renamer/index.ts",
      "default": "./dist/renamer/index.js"
    },
    "#tagger": {
      "types": "./src/tagger/index.ts",
      "default": "./dist/tagger/index.js"
    },
    "#data-provider": {
      "types": "./src/data-provider/index.ts",
      "default": "./dist/data-provider/index.js"
    },
    "#data-provider/*": {
      "types": "./src/data-provider/*/index.ts",
      "default": "./dist/data-provider/*/index.js"
    },
    "#logger": {
      "types": "./src/logger/index.ts",
      "default": "./dist/logger/index.js"
    },
    "#normalizer": {
      "types": "./src/normalizer/index.ts",
      "default": "./dist/normalizer/index.js"
    },
    "#shared-types": {
      "types": "./src/shared-types/index.ts",
      "default": "./dist/shared-types/index.js"
    }
  },
  "scripts": {
    "setup": "npx playwright install chromium",
    "typecheck": "npx tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "rm -rf ./dist",
    "start": "node ./dist/main.js",
    "build": "npm run clean && npx tsc",
    "build-start": "npm run build && npm run start",
    "check": "npm run lint && npm run typecheck && npm run build"
  },
  "author": "bearbyt3z",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "canvas": "^3.2.3",
    "file-type": "^22.0.2",
    "got": "^15.1.0",
    "jsdom": "^26.1.0",
    "node-fetch": "^3.3.2",
    "playwright": "^1.62.1",
    "prompt-sync": "^4.2.0",
    "user-agents": "^1.1.675",
    "winston": "^3.19.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^25.9.5",
    "@types/node-fetch": "^2.6.13",
    "@types/user-agents": "^1.0.4",
    "ajv": "^8.20.0",
    "eslint": "^10.9.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.11.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0"
  },
  "allowScripts": {
    "canvas@3.2.3": true,
    "unrs-resolver@1.11.1": true
  }
}
